{{- if false }}

apiVersion: v1
kind: ConfigMap
metadata:
  name: postgres-initdb
  namespace: {{ .Values.namespace }}
data:
  init.sql: |
    CREATE DATABASE {{ .Values.db.userDb }};              # userdb
    CREATE DATABASE {{ .Values.db.searchDb }};            # searchdb
    CREATE DATABASE {{ .Values.db.bookingDb }};           # bookingdb
    CREATE DATABASE {{ .Values.db.paymentDb }};           # paymentdb
    CREATE DATABASE {{ .Values.db.notificationDb }};      # notificationdb

{{- end }}
